rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function prijavljen() { return request.auth != null; }
    function vlasnikPostoji() { return exists(/databases/$(database)/documents/config/vlasnik); }
    function jeVlasnik() {
      return prijavljen() && vlasnikPostoji()
        && get(/databases/$(database)/documents/config/vlasnik).data.uid == request.auth.uid;
    }
    function jeRadnik() {
      return prijavljen() && exists(/databases/$(database)/documents/osoblje/$(request.auth.uid));
    }
    function jeAktivan() {
      return jeRadnik() && get(/databases/$(database)/documents/osoblje/$(request.auth.uid)).data.get('uloga', 'radnik') != 'gost';
    }
    function jePregled() {
      return jeAktivan() && get(/databases/$(database)/documents/osoblje/$(request.auth.uid)).data.get('pregled', false) == true;
    }
    function jeUrednik() {
      return jeAktivan() && get(/databases/$(database)/documents/osoblje/$(request.auth.uid)).data.get('urednik', false) == true;
    }
    match /pravila/{v} {
      allow get: if v == 'v7';
    }
    match /config/vlasnik {
      allow read: if true;
      allow create: if prijavljen() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /osoblje/{uid} {
      allow read: if true;
      allow create, update, delete: if jeVlasnik();
    }
    match /porudzbine/{id} {
      allow read: if jeRadnik();
      allow create: if jeRadnik();
      allow update: if jeVlasnik() || jeUrednik() || (jeAktivan() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['vrsta', 'broj', 'ime', 'telefon', 'napomena', 'opis', 'sesija', 'kidanje', 'zaKidanje',
         'dolazi', 'dolaziDatum', 'kreirano', 'upisao', 'upisaoIme', 'datum', 'grupa', 'pola']));
      allow delete: if jeVlasnik() || jeUrednik();
    }
    match /istorija/{id} {
      allow create: if jeRadnik();
      allow read, update: if jeVlasnik() || jePregled();
      allow delete: if jeVlasnik();
    }
    match /sesije/{id} {
      allow read: if jeRadnik();
      allow create, update: if jeAktivan();
      allow delete: if jeVlasnik();
    }
    match /podesavanja/{id} {
      allow read: if jeRadnik();
      allow write: if jeAktivan();
    }
    match /brojevi/{id} {
      allow read, write: if jeRadnik();
    }
  }
}
