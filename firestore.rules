rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function prijavljen() { return request.auth != null; }
    function vlasnikPostoji() { return exists(/databases/$(database)/documents/config/vlasnik); }
    function jeVlasnik() {
      return prijavljen() && vlasnikPostoji()
        && get(/databases/$(database)/documents/config/vlasnik).data.uid == request.auth.uid;
    }
    function jeRadnik() {
      return prijavljen() && exists(/databases/$(database)/documents/osoblje/$(request.auth.uid));
    }
    // Radnik kome je vlasnik u Osoblju dozvolio da vidi događaje i istoriju.
    function jePregled() {
      return jeRadnik() && get(/databases/$(database)/documents/osoblje/$(request.auth.uid)).data.get('pregled', false) == true;
    }
    // Radnik kome je vlasnik u Osoblju dozvolio da mijenja i briše upise.
    function jeUrednik() {
      return jeRadnik() && get(/databases/$(database)/documents/osoblje/$(request.auth.uid)).data.get('urednik', false) == true;
    }

    // Prvo pokretanje: prvi prijavljeni postavlja sebe za vlasnika, kasnije se ne može promijeniti.
    match /config/vlasnik {
      allow read: if true;
      allow create: if prijavljen() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Imena radnika vide se na ekranu za prijavu. Mijenja ih samo vlasnik.
    match /osoblje/{uid} {
      allow read: if true;
      allow create, update, delete: if jeVlasnik();
    }

    // Pečenja: radnici upisuju i označavaju preuzeto/iskidano/mjesto.
    // Izmjenu podataka (broj, ime, telefon...) i brisanje radi vlasnik i radnik sa dozvolom.
    match /porudzbine/{id} {
      allow read, create: if jeRadnik();
      allow update: if jeVlasnik() || jeUrednik() || (jeRadnik() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['vrsta', 'broj', 'ime', 'telefon', 'napomena', 'opis', 'sesija', 'kidanje', 'zaKidanje',
         'dolazi', 'dolaziDatum', 'kreirano', 'upisao', 'upisaoIme', 'datum', 'grupa']));
      allow delete: if jeVlasnik() || jeUrednik();
    }

    // Istoriju upisuju svi (svaka radnja se bilježi), a čitaju samo vlasnik i radnici sa dozvolom.
    match /istorija/{id} {
      allow create: if jeRadnik();
      allow read, update: if jeVlasnik() || jePregled();
      allow delete: if jeVlasnik();
    }
    match /sesije/{id} {
      allow read, create, update: if jeRadnik();
      allow delete: if jeVlasnik();
    }
    match /podesavanja/{id} {
      allow read, write: if jeRadnik();
    }
    match /brojevi/{id} {
      allow read, write: if jeRadnik();
    }
  }
}
